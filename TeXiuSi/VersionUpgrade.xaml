<Window x:Class="TeXiuSi.VersionUpgrade"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeXiuSi"
        mc:Ignorable="d" WindowStyle="None"
         Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button x:Name="btnReturn" Width='160' Height="45" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20 0 0 0" Click="btnReturn_Click">返回</Button>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="80"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" > 关节序号:</TextBlock>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" > ---</TextBlock>

            <GroupBox Grid.Row="1" Grid.ColumnSpan="2"
  Margin="10 0"
  materialDesign:ElevationAssist.Elevation="Dp6"
  Header="版本升级"
  Style="{StaticResource MaterialDesignCardGroupBox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="主控" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="硬件版本:" />
                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="---" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="软件版本:" />
                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="---" />
                    <TextBlock  Grid.Row="3" VerticalAlignment="Center" Text="关节驱动" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="关节版本:" />
                    <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="---" />
                    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="硬件版本:" />
                    <TextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="---" />

                   
                       </Grid>
            </GroupBox>
            <StackPanel Grid.Row="2" Orientation="Vertical" Grid.ColumnSpan="2">
                <Button Width='230' Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20 10 0 0">加载软件包</Button>
                <Button Width='230' Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20 10 0 0">开始升级</Button>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" Grid.Column="2" materialDesign:DataGridAssist.SelectedCellBorderBrush="Crimson"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Items4}" />
        
    </Grid>
</Window>
