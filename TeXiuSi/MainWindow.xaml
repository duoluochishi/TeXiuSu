<Window x:Class="TeXiuSi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:TeXiuSi"
        xmlns:cvt="clr-namespace:TeXiuSi.Convert"
        xmlns:uc="clr-namespace:TeXiuSi.uc"
        xmlns:converters="clr-namespace:TeXiuSi.Convert"
        xmlns:helper="clr-namespace:TeXiuSi.Helper"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowState="Normal" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Title="MainWindow" Height="1000" Width="1600">
    <Window.Resources>
        <ResourceDictionary>
            <helper:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <cvt:PercentageConverter x:Key="PercentConverter"/>
            <converters:BooleanToColorConverter x:Key="StatusColorConverter" 
                                       TrueBrush="Green" 
                                       FalseBrush="Red"/>
            <x:Array x:Key="JointNames" Type="sys:String">
                <sys:String>1</sys:String>
                <sys:String>2</sys:String>
                <sys:String>3</sys:String>
                <sys:String>4</sys:String>
                <sys:String>5</sys:String>
                <sys:String>6</sys:String>
            </x:Array>
            <x:Array x:Key="Position" Type="sys:String">
                <sys:String>起点</sys:String>
                <sys:String>中点</sys:String>
                <sys:String>终点</sys:String>
            </x:Array>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition ></RowDefinition>
            <RowDefinition Height="70"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="230"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Button Width='120' HorizontalAlignment="Left" Margin="10 0 0 0" Click="Button_Click">机械臂通讯</Button>
            <Ellipse Width="30" Height="30" Margin="160 0 0 0" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center"
                 Stroke="Transparent" 
                 StrokeThickness="2"
                 Fill="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="0 0 20 0">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">速度：</TextBlock>
                <Slider  HorizontalAlignment="Center" VerticalAlignment="Center"
  Maximum="50" Width="200" 
  Minimum="0"
  Value="35" />
            </StackPanel>


            <Button Grid.Column="3" Width='80' HorizontalAlignment="Left" Foreground="White" Command="{Binding DisabledCommand}"
                    Visibility="{Binding IsJointConnected, Converter={StaticResource BooleanToVisibilityConverter}}">失能</Button>
            <Button Grid.Column="3" Width='80' HorizontalAlignment="Left" Foreground="White" Command="{Binding ConnectCommand}"
                    Visibility="{Binding IsJointConnected, 
                                     Converter={StaticResource InverseBooleanToVisibilityConverter},
                                     ConverterParameter=Inverse}">使能</Button>
            <Button Grid.Column="1" Width='80' HorizontalAlignment="Left" Foreground="White" Click="Button_Click_3" Visibility="Collapsed">获取信息</Button>
            <Button Grid.Column="4" Width='80' HorizontalAlignment="Left" Margin="10 0 0 0" Foreground="White" Command="{Binding ScramCommand}">急停</Button>
            <Button x:Name="btnMin" Grid.Column="6"

  Style="{StaticResource MaterialDesignIconButton}"
  ToolTip="MaterialDesignIconButton" Click="btnMin_Click">
                <materialDesign:PackIcon
    Kind="WindowMinimize" />
            </Button>
            <Button Grid.Column="6" x:Name="btnMax" Visibility="Collapsed"

Style="{StaticResource MaterialDesignIconButton}"
ToolTip="MaterialDesignIconButton" Click="btnMax_Click">
                <materialDesign:PackIcon
  Kind="WindowMaximize" />
            </Button>
            <Button Grid.Column="7" x:Name="btnClose" 

Style="{StaticResource MaterialDesignIconButton}"
ToolTip="MaterialDesignIconButton" Click="btnClose_Click">
                <materialDesign:PackIcon
  Kind="WindowClose" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid>
                <materialDesign:Card >
                    <TabControl x:Name="TableControl"
    Style="{StaticResource MaterialDesignFilledTabControl}"
    TabStripPlacement="Left" >
                        <TabItem
      Header="   用户操作区      " >
                            <ScrollViewer>
                                <materialDesign:Card>
                                    <TabControl
    HorizontalContentAlignment="Left">
                                        <TabItem
      Header="运动控制">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition Height="100"></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="67*"></ColumnDefinition>
                                                    <ColumnDefinition Width="27*"/>
                                                    <ColumnDefinition Width="94*"></ColumnDefinition>
                                                    <ColumnDefinition Width="94*"></ColumnDefinition>
                                                    <ColumnDefinition Width="94*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Margin="20,20,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="23" Grid.ColumnSpan="2"> 运动方式:</TextBlock>
                                                <ComboBox
    x:Name="Outlined"  Grid.Column="1"
    Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
    ItemsSource="{Binding SportTypes}"
    DisplayMemberPath="DisplayName"
    SelectedItem="{Binding SelectedSportType}"
    Style="{StaticResource MaterialDesignOutlinedComboBox}" Grid.ColumnSpan="2" Margin="20,10,0,0"
    />
                                                <TextBlock Grid.Column="3" Margin="71,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="23" Visibility="Collapsed"> 操作模式:</TextBlock>
                                                <ComboBox
    x:Name="OutlinedComboBox" Grid.Column="3" Visibility="Collapsed"
    Width="150" HorizontalAlignment="Left"
    ItemsSource="{Binding OperationModes}"
    SelectedItem="{Binding SelectedOperationMode}"                                          
    DisplayMemberPath="DisplayName"
    Style="{StaticResource MaterialDesignOutlinedComboBox}" Grid.ColumnSpan="2" Margin="188,0,0,0"
    />
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Grid.RowSpan="3" Visibility="{Binding IsPointMotionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="10,10,10,10">
                                                        <GroupBox Padding="8" materialDesign:ElevationAssist.Elevation="Dp6" Style="{StaticResource MaterialDesignCardGroupBox}">
                                                            <GroupBox.Header >
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Foreground="White" Kind="Wrench" />
                                                                    <TextBlock Foreground="White"  Margin="8,0,0,0" Text="臂体位姿（单位：°）" />

                                                                </StackPanel>
                                                            </GroupBox.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition Width="180"></ColumnDefinition>
                                                                    <ColumnDefinition Width="180"></ColumnDefinition>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition></RowDefinition>
                                                                    <RowDefinition></RowDefinition>
                                                                    <RowDefinition></RowDefinition>
                                                                </Grid.RowDefinitions>
                                                                <StackPanel>
                                                                    <Button Name="ZMinusButton1"
                                                                    Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}"
 ToolTip="Z轴负方向"
            Command="{Binding ZMinusCommand1}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowDown" />
                                                                    </Button>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Z-</TextBlock>
                                                                </StackPanel>


                                                                <StackPanel Grid.Column="2">

                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">X+</TextBlock>
                                                                    <Button Name="XPlusButton1"
                                                            Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
  ToolTip="X轴正方向"
            Command="{Binding XPlusCommand1}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowUp" />
                                                                    </Button>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="4">
                                                                    <Button Name="ZPlusButton1"
                                                            Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
 ToolTip="Z轴正方向"
            Command="{Binding ZPlusCommand1}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowUp" />
                                                                    </Button>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Z+</TextBlock>
                                                                </StackPanel>


                                                                <StackPanel Grid.Row="1" Grid.Column="1" >

                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Y-</TextBlock>
                                                                    <Button Name="YMinusButton1"
                                                                Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
 ToolTip="Y轴负方向"
            Command="{Binding YMinusCommand1}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowLeft" />
                                                                    </Button>
                                                                </StackPanel>

                                                                <StackPanel Grid.Row="1" Grid.Column="3">

                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Y+</TextBlock>
                                                                    <Button Name="YPlusButton1"
                                                                Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
            ToolTip="Y轴正方向"
            Command="{Binding YPlusCommand1}">
                                                                        <materialDesign:PackIcon
                                                                Width="34"
                                                                Height="34"
                                                                Kind="ArrowRight" />
                                                                    </Button>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                                    <Button Name="XMinusButton1"
                                                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                                                Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
 ToolTip="X轴负方向"
            Command="{Binding XMinusCommand1}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowDown" />
                                                                    </Button>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">X-</TextBlock>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="5" Orientation="Vertical" Grid.RowSpan="4" Margin="10 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 10 10 10">▲X:</TextBlock>
                                                                        <materialDesign:NumericUpDown  FontSize="20"   Width="130"
                                                                Style="{StaticResource MaterialDesignFilledNumericUpDown}" Height="50"
                                                                Value="{Binding StepXValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}">
                                                                            <materialDesign:NumericUpDown.IncreaseContent>
                                                                                <materialDesign:PackIcon Kind="PlusCircle" />
                                                                            </materialDesign:NumericUpDown.IncreaseContent>

                                                                            <materialDesign:NumericUpDown.DecreaseContent>
                                                                                <materialDesign:PackIcon Kind="MinusCircle " />
                                                                            </materialDesign:NumericUpDown.DecreaseContent>
                                                                        </materialDesign:NumericUpDown>

                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 10 10 10">▲Y:</TextBlock>
                                                                        <materialDesign:NumericUpDown  FontSize="20"  Width="130"
     Style="{StaticResource MaterialDesignFilledNumericUpDown}" Height="50"
     Value="{Binding StepYValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 20">
                                                                            <materialDesign:NumericUpDown.IncreaseContent>
                                                                                <materialDesign:PackIcon Kind="PlusCircle" />
                                                                            </materialDesign:NumericUpDown.IncreaseContent>

                                                                            <materialDesign:NumericUpDown.DecreaseContent>
                                                                                <materialDesign:PackIcon Kind="MinusCircle " />
                                                                            </materialDesign:NumericUpDown.DecreaseContent>
                                                                        </materialDesign:NumericUpDown>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 10 10 10" FontSize="16">▲Z:</TextBlock>
                                                                        <materialDesign:NumericUpDown  FontSize="20"  Width="130"
 Style="{StaticResource MaterialDesignFilledNumericUpDown}" Height="50"
  Value="{Binding StepZValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" >
                                                                            <materialDesign:NumericUpDown.IncreaseContent>
                                                                                <materialDesign:PackIcon Kind="PlusCircle" />
                                                                            </materialDesign:NumericUpDown.IncreaseContent>

                                                                            <materialDesign:NumericUpDown.DecreaseContent>
                                                                                <materialDesign:PackIcon Kind="MinusCircle " />
                                                                            </materialDesign:NumericUpDown.DecreaseContent>
                                                                        </materialDesign:NumericUpDown>
                                                                    </StackPanel>
                                                                </StackPanel>



                                                                <StackPanel Grid.Column="6" Grid.RowSpan="6" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 10 0"  FontSize="16">X:</TextBlock>
                                                                        <TextBox Text="{Binding XValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"                                                          
                                                             Width="130" Height="50"                                                   
                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="16"  Margin="0 10 10 10">Y:</TextBlock>
                                                                        <TextBox   Text="{Binding YValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"                                                          
                                                             Width="130" Height="50"                                                    
                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0 20"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="16" Margin="0 0 10 0">Z:</TextBlock>
                                                                        <TextBox  Text="{Binding ZValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                             Width="130" Height="50"
                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                                                    </StackPanel>

                                                                </StackPanel>
                                                            </Grid>
                                                        </GroupBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="10,10,10,10">
                                                        <GroupBox Padding="8" materialDesign:ElevationAssist.Elevation="Dp6" Style="{StaticResource MaterialDesignCardGroupBox}">
                                                            <GroupBox.Header >
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Foreground="White" Kind="Wrench" />
                                                                    <TextBlock Foreground="White"  Margin="8,0,0,0" Text="臂体位姿（单位：°）" />

                                                                </StackPanel>
                                                            </GroupBox.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition Width="180"></ColumnDefinition>
                                                                    <ColumnDefinition Width="180"></ColumnDefinition>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition></RowDefinition>
                                                                    <RowDefinition></RowDefinition>
                                                                    <RowDefinition></RowDefinition>
                                                                </Grid.RowDefinitions>
                                                                <StackPanel>
                                                                    <Button Name="ZMinusButton2"
                                                                    Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}"
                                                                        ToolTip="Z轴负方向"
                                                                        Command="{Binding ZMinusCommand2}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowDown" />
                                                                    </Button>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Z-</TextBlock>
                                                                </StackPanel>


                                                                <StackPanel Grid.Column="2">

                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">X+</TextBlock>
                                                                    <Button Name="XPlusButton2"
                                                            Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
                                                            ToolTip="X轴正方向"
                                                            Command="{Binding XPlusCommand2}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowUp" />
                                                                    </Button>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="4">
                                                                    <Button Name="ZPlusButton2"
                                                            Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
                                                            ToolTip="Z轴正方向"
                                                            Command="{Binding ZPlusCommand2}">
                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowUp" />
                                                                    </Button>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Z+</TextBlock>
                                                                </StackPanel>


                                                                <StackPanel Grid.Row="1" Grid.Column="1" >

                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Y-</TextBlock>
                                                                    <Button Name="YMinusButton2"
                                                                Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
                                                                ToolTip="Y轴负方向" Command="{Binding YMinusCommand2}">
                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowLeft" />
                                                                    </Button>
                                                                </StackPanel>

                                                                <StackPanel Grid.Row="1" Grid.Column="3">

                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">Y+</TextBlock>
                                                                    <Button Name="YPlusButton2"
                                                                Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
                                                                ToolTip="Y轴正方向"
                                                                Command="{Binding YPlusCommand2}">

                                                                        <materialDesign:PackIcon
                                                                Width="34"
                                                                Height="34"
                                                                Kind="ArrowRight" />
                                                                    </Button>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                                    <Button Name="XMinusButton2"
                                                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                                                Style="{StaticResource MaterialDesignFloatingActionSecondaryDarkButton}" 
                                                                ToolTip="X轴负方向"  Command="{Binding XMinusCommand2}">

                                                                        <materialDesign:PackIcon
                                                                        Width="34"
                                                                        Height="34"
                                                                        Kind="ArrowDown" />
                                                                    </Button>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 5 0 0">X-</TextBlock>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="5" Orientation="Vertical" Grid.RowSpan="4" Margin="10 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 10 10 10">▲Rx:</TextBlock>
                                                                        <materialDesign:NumericUpDown  FontSize="20"   Width="130"
                                                                Style="{StaticResource MaterialDesignFilledNumericUpDown}" Height="50"
                                                                Value="{Binding StepRollvalue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" >
                                                                            <materialDesign:NumericUpDown.IncreaseContent>
                                                                                <materialDesign:PackIcon Kind="PlusCircle" />
                                                                            </materialDesign:NumericUpDown.IncreaseContent>

                                                                            <materialDesign:NumericUpDown.DecreaseContent>
                                                                                <materialDesign:PackIcon Kind="MinusCircle " />
                                                                            </materialDesign:NumericUpDown.DecreaseContent>
                                                                        </materialDesign:NumericUpDown>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Margin="0 10 10 10">▲Ry:</TextBlock>
                                                                        <materialDesign:NumericUpDown  FontSize="20"  Width="130"
                                                                            Style="{StaticResource MaterialDesignFilledNumericUpDown}" Height="50"
                                                                            Value="{Binding StepPitchvalue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 20">
                                                                            <materialDesign:NumericUpDown.IncreaseContent>
                                                                                <materialDesign:PackIcon Kind="PlusCircle" />
                                                                            </materialDesign:NumericUpDown.IncreaseContent>

                                                                            <materialDesign:NumericUpDown.DecreaseContent>
                                                                                <materialDesign:PackIcon Kind="MinusCircle " />
                                                                            </materialDesign:NumericUpDown.DecreaseContent>
                                                                        </materialDesign:NumericUpDown>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 10 10 10" FontSize="16">▲Rz:</TextBlock>
                                                                        <materialDesign:NumericUpDown  FontSize="20"  Width="130"
                                                                    Style="{StaticResource MaterialDesignFilledNumericUpDown}" Height="50" Maximum="1"  Minimum="0"
                                                                    Value="{Binding StepYawValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" >
                                                                            <materialDesign:NumericUpDown.IncreaseContent>
                                                                                <materialDesign:PackIcon Kind="PlusCircle" />
                                                                            </materialDesign:NumericUpDown.IncreaseContent>

                                                                            <materialDesign:NumericUpDown.DecreaseContent>
                                                                                <materialDesign:PackIcon Kind="MinusCircle " />
                                                                            </materialDesign:NumericUpDown.DecreaseContent>
                                                                        </materialDesign:NumericUpDown>
                                                                    </StackPanel>
                                                                </StackPanel>



                                                                <StackPanel Grid.Column="6" Grid.RowSpan="6" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 10 0"  FontSize="16">Rx:</TextBlock>
                                                                        <TextBox   Text="{Binding Rollvalue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"                                                          
                                                             Width="130" Height="50"                                                   
                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                                                                   PreviewTextInput="NumberValidationTextBox"
                                                                                   LostFocus="LimitValue_LostFocus"
                                                                                   DataObject.Pasting="PastingNumberValidation"
                                                                                   
                                                                                   />
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="16"  Margin="0 10 10 10">Ry:</TextBlock>
                                                                        <TextBox    Text="{Binding Pitchvalue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"                                                         
                                                             Width="130" Height="50"                                                    
                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0 20"
                                                                                    PreviewTextInput="NumberValidationTextBox"
                                                                                    LostFocus="LimitValue_LostFocus"
                                                                                    DataObject.Pasting="PastingNumberValidation"
                                                                                    
                                                                                    />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="16" Margin="0 0 10 0">Rz:</TextBlock>
                                                                        <TextBox  Text="{Binding YawValue, StringFormat='F2', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                             Width="130" Height="50"
                                                            Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                                                            PreviewTextInput="NumberValidationTextBox"
                                                                            LostFocus="LimitValue_LostFocus"
                                                                            DataObject.Pasting="PastingNumberValidation"/>
                                                                    </StackPanel>

                                                                </StackPanel>
                                                            </Grid>
                                                        </GroupBox>
                                                    </StackPanel>



                                                    <StackPanel Orientation="Horizontal"  Grid.Row="3" Grid.ColumnSpan="5" HorizontalAlignment="Center" Margin="0 10 0 0"  >
                                                        <Button Name="ResetToZeroButton" 
 Width="300" Height="50" Margin="0 0 30 0"
Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding ResetToZeroCommand}">

                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon
        Kind="ApproximatelyEqual" 
        Margin="0 0 8 0" />
                                                                <TextBlock
        Text="回零" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Name="LoadButton" 
 Width="300" Height="50" Margin="30 0" Visibility="Collapsed"
    Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding LoadCommand}">

                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon
            Kind="CellphoneArrowDownVariant" 
            Margin="0 0 8 0" />
