<Window x:Class="TeXiuSi.uc.TrajectoryLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeXiuSi.uc"
        mc:Ignorable="d"
        Title="TraceLib" Height="720" Width="1638">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.ColumnSpan="5" materialDesign:DataGridAssist.SelectedCellBorderBrush="Crimson"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Items4}" />


        <Button Grid.Row="1" Width="220"  Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding ImportFileCommand}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
Kind="FilePlusOutline" 
Margin="0 0 8 0" />
                <TextBlock
Text="导入文件" />
            </StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="1"   Width="220"  Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding NewTrajectoryCommand}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
Kind="PlusCircleOutline" 
Margin="0 0 8 0" />
                <TextBlock
Text="新建" />
            </StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="2"   Width="220"  Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding DeleteTrajectoryCommand}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
Kind="DeleteOutline" 
Margin="0 0 8 0" />
                <TextBlock
Text="删除" />
            </StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="3"   Width="220"  Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding SendTrajectoryCommand}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
Kind="SendVariantOutline" 
Margin="0 0 8 0" />
                <TextBlock
Text="发送" />
            </StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="4"   Width="220"  Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding ExportFileCommand}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
Kind="FileDownloadOutline" 
Margin="0 0 8 0" />
                <TextBlock
Text="导出文件" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
