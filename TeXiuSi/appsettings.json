{
  "Serilog": {
    // 1. 设置默认的最低日志级别
    "MinimumLevel": {
      "Default": "Information", // 默认级别为 Information 及以上
      "Override": {
        "Microsoft": "Warning", // 覆盖 Microsoft 命名空间的日志，只记录 Warning 及以上
        "System": "Warning"
      }
    },
    // 2. 配置 Sink (日志输出目标)
    "WriteTo": [
      // 输出到控制台 (需要安装 Serilog.Sinks.Console)
      { "Name": "Console" },
      // 输出到文件 (需要安装 Serilog.Sinks.File)
      {
        "Name": "File",
        "Args": {
          "path": "logs/applog.txt", // 日志文件路径
          "rollingInterval": "Day", // 每天滚动
          // 自定义输出格式，与代码配置中的 outputTemplate 作用相同
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    // 3. 配置 Enrichers (富化器)
    "Enrich": [
      "FromLogContext",
      "WithMachineName", // 需要安装 Serilog.Enrichers.Environment
      "WithThreadId" // 需要安装 Serilog.Enrichers.Thread
    ]
  }
}